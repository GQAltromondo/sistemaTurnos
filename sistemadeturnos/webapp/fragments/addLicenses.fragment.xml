<core:FragmentDefinition xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core" width="50%">
    <Dialog id="formAddLicense" title="{i18n>newShift}">
        <content>
            <f:Form >
                <f:layout>
                    <f:ResponsiveGridLayout labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="" columnsM="2" singleContainerFullSize="true" />
                </f:layout>
                <f:formContainers>
                    <f:FormContainer>
                        <f:formElements>
                            <f:FormElement>
                                <f:fields>
                                    <!-- <VBox justifyContent="SpaceBetween">
                                        <Label text="{i18n>init}:" required="true" />
                                        <DatePicker id="fromDate" width="40%" valueFormat="dd.MM.yyyy" displayFormat="dd.MM.yyyy" change="handleChange" class="sapUiSmallMarginBottom" />
                                       <Label text="{i18n>end}:" required="true" />
                                        <DatePicker id="toDate" width="40%" valueFormat="dd.MM.yyyy" displayFormat="dd.MM.yyyy" change="handleChange" class="sapUiSmallMarginBottom" />
                                   <Button icon="sap-icon://search" press="onSelectLicense"></Button>
                                    </VBox> -->
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement>
                                <f:fields>
                                    <VBox justifyContent="SpaceBetween">
                                        <Table id="idLicensesTable" items="{SearchLicense>/}" inset="false" class="" mode="MultiSelect">
                                              <headerToolbar>
                                                <Toolbar>
                                                    <ToolbarSpacer/>
                                                    <SearchField
                                                        width="18rem"
                                                        liveChange=".onLicenseSearch"
                                                        placeholder="Buscar turno..."/>
                                                </Toolbar>
                                            </headerToolbar>
                                            <columns>
                                                <Column>
                                                    <header>
                                                        <Text text="ID"/>
                                                    </header>
                                                </Column>
                                                <Column>
                                                    <header>
                                                        <Text text="Equipo"/>
                                                    </header>
                                                </Column>
                                                <Column>
                                                    <header>
                                                        <Text text="Condiciones de trabajo"/>
                                                    </header>
                                                </Column>
                                                <Column>
                                                    <header>
                                                        <Text text="{i18n>initHour}"/>
                                                    </header>
                                                </Column>
                                                <Column>
                                                    <header>
                                                        <Text text="{i18n>toDoWork}"/>
                                                    </header>
                                                </Column>
                                                <Column>
                                                    <header>
                                                        <Text text="{i18n>region}"/>
                                                    </header>
                                                </Column>
                                                <Column>
                                                    <header>
                                                        <Text text="{i18n>Estado}"/>
                                                    </header>
                                                </Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem >
                                                    <cells>
                                                        <Text text="{SearchLicense>Id}"/>
                                                        <Text text="{SearchLicense>Equnr}"/>
                                                        <Text text="{path: 'SearchLicense>Jobcond', formatter: '.formatter.getJobCond'}" textAlign="Center" wrapping="true"/>
                                                        <Text text="{path:'SearchLicense>Gdate', formatter: '.formatter.msTohoursSeconds'}" class="text-bold" wrapping="false"/>
                                                        <Text text="{SearchLicense>Comments}" wrapping="false"/>
                                                        <Text text="{path: 'SearchLicense>Werks', formatter: '.formatter.getRegiones'}" textAlign="Center" wrapping="true"/>
                                                        <Text text="{path: 'SearchLicense>Licstat', formatter: '.formatter.formatLicState'}" textAlign="Center" wrapping="true"/>
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>

                                        <!-- 
                                        <t:Column
                                        id="state"
                                        width="250px"
                                        sortProperty="Licstat"
                                        filterProperty="Licstat"
                                    >
                                        <Label text="{i18n>state}" />
                                        <t:template>
                                            <Text
                                                text="{path: 'LicencesJsonModel>Licstat', formatter: '.formatter.formatLicState'}"
                                                textAlign="Center"
                                                wrapping="false"
                                            />
                                        </t:template>
                                    </t:Column>
                                         -->

                                    </VBox>
                                </f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                </f:formContainers>
            </f:Form>
        </content>
        <beginButton>
            <Button icon="sap-icon://add" text="Agregar" press="onPressAdd" />
        </beginButton>
        <endButton>
            <Button icon="sap-icon://inspect-down" text="Cerrar" press="closeDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
