<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Popover
        title="{i18n>seleccioneAcciones}"
        contentWidth="400px"
        contentHeight="350px"
        placement="VerticalPreferredBottom"
        class="popoverAccionesEntrega"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <List
                    id="listaAccionesEntrega"
                    items="{CatalogoCodigosModel>/}"
                    showNoData="false"
                    showSeparators="None"
                >
                    <CustomListItem>
                        <CheckBox
                            text="{
        parts: [
            {path: 'CatalogoCodigosModel>Codigo'},
            {path: 'CatalogoCodigosModel>Accion'}
        ],
        formatter: '.formatCodigoAccion'
    }"
                            select=".onCheckBoxSelectEntrega"
                        >
                            <customData>
                                <core:CustomData
                                    key="key"
                                    value="{CatalogoCodigosModel>Codigo}"
                                />
                                <core:CustomData
                                    key="descripcion"
                                    value="{CatalogoCodigosModel>Accion}"
                                />
                                <core:CustomData
                                    key="descripcionCompleta"
                                    value="{CatalogoCodigosModel>Descripcion}"
                                />
                            </customData>
                        </CheckBox>
                    </CustomListItem>
                </List>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="{i18n>guardar}"
                type="Emphasized"
                press=".onGuardarAccionesEntrega"
            />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>cerrar}"
                press=".onCerrarPopoverEntrega"
            />
        </endButton>
    </Popover>
</core:FragmentDefinition>
