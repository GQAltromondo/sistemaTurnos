<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <Dialog
        id="pdfViewerDialog"
        title="{i18n>pdfViewerTitle}"
        contentWidth="900px"
        contentHeight="700px"
        resizable="true"
        draggable="true">
        
        <content>
            <ScrollContainer width="100%" height="600px" vertical="true" horizontal="true">
                <content>
                    <core:HTML id="pdfViewerContent" content=""/>
                </content>
            </ScrollContainer>
        </content>
        
        <beginButton>
            <Button 
                text="{i18n>acceptButton}" 
                type="Emphasized"
                press="onAcceptPDFViewer"/>
        </beginButton>
        
        <buttons>
            <Button 
                text="{i18n>downloadButton}" 
                icon="sap-icon://download"
                press="onDownloadFromViewer"/>
            <Button 
                text="{i18n>closeButton}" 
                press="onClosePDFViewer"/>
        </buttons>
    </Dialog>
    
</core:FragmentDefinition>
