<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
>
    <viz:VizFrame
        id="lineVizFrame"
        vizType="line"
        width="100%"
        height="400px"
        uiConfig="{applicationSet:'fiori'}"
        selectData="onChartDataSelect"
    >
        <!-- Dataset: Desvíos por acción (real vs. previsto) -->
        <viz:dataset>
            <viz.data:FlattenedDataset data="{chartModel>/data}">
                <viz.data:dimensions>
                    <viz.data:DimensionDefinition
                        name="Accion"
                        value="{chartModel>Accion}"
                    />
                </viz.data:dimensions>

                <viz.data:measures>
                    <!-- Previsto: referencia en 0 (sin desvío) -->
                    <viz.data:MeasureDefinition
                        name="Previsto"
                        value="{chartModel>Previsto}"
                    />
                    <!-- Promedio: tiempo real promedio entre licencias -->
                    <viz.data:MeasureDefinition
                        name="Promedio"
                        value="{chartModel>Promedio}"
                    />
                    <!-- Mínimo: menor desvío observado -->
                    <viz.data:MeasureDefinition
                        name="Mínimo"
                        value="{chartModel>DesvioMin}"
                    />
                    <!-- Máximo: mayor desvío observado -->
                    <viz.data:MeasureDefinition
                        name="Máximo"
                        value="{chartModel>DesvioMax}"
                    />
                </viz.data:measures>
            </viz.data:FlattenedDataset>
        </viz:dataset>

        <!-- Feeds -->
        <viz:feeds>
            <viz.feeds:FeedItem
                uid="categoryAxis"
                type="Dimension"
                values="Accion"
            />
            <viz.feeds:FeedItem
                uid="valueAxis"
                type="Measure"
                values="Previsto,Promedio,Mínimo,Máximo"
            />
        </viz:feeds>
    </viz:VizFrame>
</core:FragmentDefinition>
