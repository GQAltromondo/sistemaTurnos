<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

    <viz:VizFrame
        id="lineVizFrame"
        vizType="line"
        width="100%"
        height="400px"
        uiConfig="{applicationSet:'fiori'}">

        <!-- Dataset -->
        <viz:dataset>
            <viz.data:FlattenedDataset data="{chartModel>/data}">
                <viz.data:dimensions>
                    <viz.data:DimensionDefinition
                        name="Mes"
                        value="{chartModel>Mes}" />
                </viz.data:dimensions>

                <viz.data:measures>
                    <viz.data:MeasureDefinition
                        name="Línea 1"
                        value="{chartModel>Linea1}" />
                    <viz.data:MeasureDefinition
                        name="Línea 2"
                        value="{chartModel>Linea2}" />
                </viz.data:measures>
            </viz.data:FlattenedDataset>
        </viz:dataset>

        <!-- Feeds -->
        <viz:feeds>
            <viz.feeds:FeedItem
                uid="categoryAxis"
                type="Dimension"
                values="Mes" />

            <viz.feeds:FeedItem
                uid="valueAxis"
                type="Measure"
                values="Línea 1,Línea 2" />
        </viz:feeds>

    </viz:VizFrame>

</core:FragmentDefinition>
