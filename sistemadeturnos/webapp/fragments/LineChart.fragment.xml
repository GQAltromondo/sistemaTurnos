<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
>
    <viz:VizFrame
        id="lineVizFrame"
        vizType="line"
        width="100%"
        height="400px"
        uiConfig="{applicationSet:'fiori'}"
        selectData="onChartDataSelect"
    >
        <!-- Dataset -->
        <viz:dataset>
            <viz.data:FlattenedDataset data="{chartModel>/data}">
                <viz.data:dimensions>
                    <viz.data:DimensionDefinition
                        name="Accion"
                        value="{chartModel>Accion}"
                    />
                </viz.data:dimensions>

                <viz.data:measures>
                    <viz.data:MeasureDefinition
                        name="TiempoPrevisto"
                        value="{chartModel>TiempoPrevisto}"
                    />
                    <viz.data:MeasureDefinition
                        name="TiempoReal"
                        value="{chartModel>TiempoReal}"
                    />
                </viz.data:measures>
            </viz.data:FlattenedDataset>
        </viz:dataset>

        <!-- Feeds -->
        <viz:feeds>
            <viz.feeds:FeedItem
                uid="categoryAxis"
                type="Dimension"
                values="Accion"
            />

            <viz.feeds:FeedItem
                uid="valueAxis"
                type="Measure"
                values="TiempoPrevisto,TiempoReal"
            />
        </viz:feeds>
    </viz:VizFrame>
</core:FragmentDefinition>
